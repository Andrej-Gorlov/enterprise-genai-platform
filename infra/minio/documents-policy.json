{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DocumentsObjectAccess",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"],
      "Resource": [
        "arn:aws:s3:::enterprise-documents/uploads/*",
        "arn:aws:s3:::enterprise-documents/documents/*"
      ]
    }
  ]
}
